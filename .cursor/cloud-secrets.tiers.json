{
  "version": 1,
  "environmentName": "soundy-msdev",
  "dashboardUrl": "https://cursor.com/dashboard/cloud-agents",
  "tiers": {
    "P0_boot": {
      "label": "P0 — Démarrage API + frontend (obligatoire)",
      "typeDefault": "Environment Variable",
      "keys": [
        { "key": "APP_ENV", "value": "msdev", "note": "Mode msdev" },
        { "key": "APP_NAME", "value": "msdev", "note": "" },
        { "key": "PORT", "value": "4080", "note": "API" },
        { "key": "HOST", "value": "0.0.0.0", "note": "Écoute VM cloud" },
        { "key": "JWT_SECRET", "value": "<copier depuis commun/msdev/.env local>", "type": "Runtime Secret", "note": "Auth sessions — min 32 caractères" },
        { "key": "CORS_ORIGIN", "value": "*", "note": "Dev cloud" },
        { "key": "WEB_APP_URL", "value": "http://localhost:5173", "note": "Terminal Vite" },
        { "key": "API_BASE_URL", "value": "http://localhost:4080/api", "note": "" },
        { "key": "SOCKET_URL", "value": "http://localhost:4080", "note": "Socket.io" },
        { "key": "MSDEV_HTTPS", "value": "0", "note": "" },
        { "key": "VITE_APP_ENV", "value": "msdev", "file": "web/app/.env.development", "note": "Frontend" },
        { "key": "VITE_DESIGN_QUICK_WINS", "value": "1", "file": "web/app/.env.development", "note": "UI carte = prod" }
      ]
    },
    "P1_salons_youtube": {
      "label": "P1 — Salons synchronisés YouTube (recommandé)",
      "typeDefault": "Runtime Secret",
      "keys": [
        { "key": "YOUTUBE_API_KEY", "value": "<copier depuis commun/msdev/.env local>", "note": "Recherche + playlists salons" },
        { "key": "GOOGLE_CLIENT_ID", "value": "<optionnel — OAuth compte>", "note": "Connexion Google" },
        { "key": "GOOGLE_CLIENT_SECRET", "value": "<optionnel>", "type": "Runtime Secret", "note": "" },
        { "key": "GOOGLE_CALLBACK_URL", "value": "http://localhost:4080/api/auth/google/callback", "type": "Environment Variable", "note": "URI cloud dev" }
      ]
    },
    "P2_data": {
      "label": "P2 — PostgreSQL (optionnel — sinon store.json local VM)",
      "typeDefault": "Runtime Secret",
      "keys": [
        { "key": "DATABASE_URL", "value": "<copier depuis commun/msdev/.env local>", "note": "Sans PG : repli store.json (limité)" },
        { "key": "PG_SSL", "value": "1", "type": "Environment Variable", "note": "Si Scaleway PG" }
      ]
    },
    "P3_lives_stripe": {
      "label": "P3 — Lives + dons (optionnel pour 1er test)",
      "typeDefault": "Runtime Secret",
      "keys": [
        { "key": "LIVEKIT_URL", "value": "<copier depuis commun/msdev/.env local>", "note": "Lives navigateur" },
        { "key": "LIVEKIT_API_KEY", "value": "<copier>", "note": "" },
        { "key": "LIVEKIT_API_SECRET", "value": "<copier>", "note": "" },
        { "key": "STRIPE_SECRET_KEY", "value": "<copier sk_test_…>", "note": "Dons msdev simulés" },
        { "key": "STRIPE_PUBLISHABLE_KEY", "value": "<copier pk_test_…>", "note": "" },
        { "key": "DONATIONS_ENABLED", "value": "1", "type": "Environment Variable", "note": "" }
      ]
    },
    "P4_moderation": {
      "label": "P4 — Modération / push (optionnel)",
      "typeDefault": "Runtime Secret",
      "keys": [
        { "key": "SIGHTENGINE_API_USER", "value": "<copier>", "note": "NSFW images" },
        { "key": "SIGHTENGINE_API_SECRET", "value": "<copier>", "note": "" },
        { "key": "SIGHTENGINE_ENABLED", "value": "1", "type": "Environment Variable", "note": "" }
      ]
    }
  },
  "cloudDefaults": {
    "WEB_APP_URL": "http://localhost:5173",
    "API_BASE_URL": "http://localhost:4080/api",
    "SOCKET_URL": "http://localhost:4080",
    "MSDEV_BOT_COUNT": "100",
    "GEO_NEARBY_WORLD_CAP": "200"
  },
  "neverCommit": [
    "commun/msdev/.env",
    "commun/backend/.env.production",
    "Valeurs dashboard → Runtime Secret sauf flags publics"
  ]
}
