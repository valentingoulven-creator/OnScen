# Copier vers apple-oauth.env (gitignoré) puis :
#   powershell -File scripts/setup-apple-signin-env.ps1 -Environment prod
#
# Apple Developer → Identifiers → Services ID (Web) + Key Sign in with Apple (.p8)

APPLE_CLIENT_ID=com.soundy.app.web
APPLE_TEAM_ID=AB12CD3EFG
APPLE_KEY_ID=XXXXXXXXXX
APPLE_CALLBACK_URL=https://onscen.com/api/auth/apple/callback
# Contenu AuthKey_XXXX.p8 (échapper les retours ligne avec \n) :
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ou chemin local vers le fichier .p8 :
# APPLE_PRIVATE_KEY_PATH=C:\secrets\AuthKey_XXXX.p8
