# Cursor local sync state (regenerated)
.cursor/cloud-sync.state.json

dist/
.env
.env.local
**/docs/youtube-audit-demo-credentials.local.txt
.env.production
.env.development
.env.*
!.env*.example
!**/.env*.example
.env.sentry-build-plugin
*.log
.DS_Store

# Personal / local-only (hors repo produit)
docs/cv/

# Playwright E2E artifacts
web/app/test-results/

# Build mobile export (regénéré par npm run apptel:build / mobile:export)
commun/backend/public/tel/

# msdev secrets (keep .env.example)
**/msdev/.env
# msdev local DB file (see msdev/data/README.md — do not iCloud-sync)
msdev/data/*.json
!msdev/data/README.md
!msdev/data/.nosync
!msdev/data/.gitignore
**/msdev/legal-publisher.json
**/msdev/ceo-founder-context.json

# Mobile store secrets (keystore, Team ID)
mobile-store.env
apple-oauth.env
apptel/android/soundy-release.jks
apptel/android/keystore.properties

# Built Windows executable (regenerate with npm run build:exe)
msdev/release/

# Auto-signed dev TLS (regenerate with msdev/scripts/generate-dev-cert.ps1)
**/msdev/certs/

# Tile proxy disk cache (auto-populated at runtime — never commit)
backend/tile-cache/
commun/backend/tile-cache/

# Snapshots de compte (restauration admin) — données privées runtime, jamais commit
backend/data/
commun/backend/data/

# Mobile build artifacts (regenerate via capacitor:android:apk)
*.apk
*.aab

# IDE
.idea/
*.swp

# Windows server proxy binary (root-level)
server.exe

# node_modules backup
app/node_modules.bak/

# Dumps pm2 (pm2 jlist/prettylist) — contiennent TOUTES les env vars process,
# donc tous les secrets prod en clair (JWT_SECRET, STRIPE_SECRET_KEY,
# DATABASE_URL...). Ne jamais committer un export de ce type.
pm2_jlist.json
pm2-jlist*.json
pm2_prettylist*.json
node_modules
