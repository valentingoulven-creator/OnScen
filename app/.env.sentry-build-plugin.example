# Copier vers app/.env.sentry-build-plugin (gitignore) pour upload source maps au build.
# Token : Sentry → Settings → Auth Tokens → Create (scopes: project:releases, org:read)
# https://sentry.io/settings/account/api/auth-tokens/

SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=bewware
SENTRY_PROJECT=javascript-react
