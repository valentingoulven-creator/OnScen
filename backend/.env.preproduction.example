APP_ENV=preproduction
PORT=3000
HOST=0.0.0.0

# Secrets DISTINCTS de la prod — ne jamais reutiliser JWT_SECRET / ENCRYPTION_KEY prod
JWT_SECRET=changez_moi_staging_jwt_secret_long
ENCRYPTION_KEY=changez_moi_staging_encryption_32_chars_min

WEB_APP_URL=https://staging.getsoundy.com
CORS_ORIGIN=https://staging.getsoundy.com

# PostgreSQL staging (meme instance Scaleway, base separee)
# DATABASE_URL=postgresql://soundy:SECRET@51.15.132.229:14440/soundy_staging?sslmode=require
DATABASE_URL=postgresql://soundy:MOT_DE_PASSE@51.15.132.229:14440/soundy_staging?sslmode=require
PG_SSL=1
PG_POOL_MAX=10

PROD_ADMIN_EMAIL=admin@getsoundy.com
PROD_ADMIN_PASSWORD=changez_moi
PROD_ADMIN_USERNAME=admin

# Stripe TEST uniquement en preprod
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# DONATIONS_ENABLED=1
# SUBSCRIPTIONS_ENABLED=1

# OAuth — ajouter redirect URIs staging dans Google/Spotify/Meta consoles
# GOOGLE_CALLBACK_URL=https://staging.getsoundy.com/api/auth/google/callback
# SPOTIFY_CALLBACK_URL=https://staging.getsoundy.com/api/auth/spotify/callback
# YOUTUBE_CALLBACK_URL=https://staging.getsoundy.com/api/auth/youtube/callback

# Sightengine (modération active — recommandé)
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# SIGHTENGINE_ENABLED=1

# LiveKit / Cloudflare (optionnel — meme projet ou test)
# LIVEKIT_URL=
# CLOUDFLARE_ACCOUNT_ID=
