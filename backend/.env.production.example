APP_ENV=production
PORT=3000
HOST=0.0.0.0

# Obligatoire en production
JWT_SECRET=changez_moi_long_random_secret

# Chiffrement des tokens OAuth plateforme (Spotify/YouTube/Instagram) au repos.
# 32+ caractères aléatoires ; repli sur JWT_SECRET si absent (non recommandé en prod).
ENCRYPTION_KEY=changez_moi_cle_chiffrement_32_caracteres_min

# URL publique de l'app (redirections OAuth Spotify/YouTube/Google)
WEB_APP_URL=https://getsoundy.com

# Origine(s) front autorisée(s) — séparées par des virgules si plusieurs
CORS_ORIGIN=https://getsoundy.com

# --- PostgreSQL (recommandé) ---
# Active automatiquement la persistance SQL quand APP_ENV=production
DATABASE_URL=postgresql://soundy:MOT_DE_PASSE@127.0.0.1:5432/soundy

# Scaleway Managed Database (Paris) — exemple :
# DATABASE_URL=postgresql://soundy:SECRET@xxx.pg.sdb.scaleway.com:5432/soundy?sslmode=require
# PG_SSL=1
# PG_POOL_MAX=10

# Premier compte admin si la base est vide
PROD_ADMIN_EMAIL=admin@votredomaine.fr
PROD_ADMIN_PASSWORD=changez_moi
PROD_ADMIN_USERNAME=admin

# Contrôle d'accès (optionnel)
# ACCESS_CONTROL_ENABLED=1
# ACCESS_ADMIN_EMAILS=admin@votredomaine.fr
# ACCESS_ADMIN_USERNAMES=soundy_dev

# Stripe / abonnements (optionnel)
# DONATIONS_ENABLED=1
# Commission plateforme sur les pourboires live (défaut 30 %, hors abonnements)
# DONATION_PLATFORM_FEE_PERCENT=30
# SUBSCRIPTIONS_ENABLED=1
# STRIPE_SECRET_KEY=sk_live_...

# ── Connexion sociale OAuth (optionnel) ──────────────────────────────────────
# Les boutons Google/Facebook apparaissent en mode "Bientôt disponible" tant
# que ces variables ne sont pas définies. Aucun redéploiement du frontend
# n'est nécessaire : le backend expose /api/auth/providers pour la détection.
#
# Google (connexion compte + YouTube) — console.cloud.google.com
# 1. Créer un projet → APIs & Services → activer « YouTube Data API v3 »
# 2. OAuth consent screen → External → scopes : youtube.readonly, email, profile
# 3. Credentials → OAuth 2.0 Client ID → Web application
# 4. Authorized redirect URIs :
#    - https://getsoundy.com/api/auth/youtube/callback  (liaison YouTube)
#    - https://getsoundy.com/api/auth/google/callback   (connexion compte, optionnel)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLE_CALLBACK_URL=https://getsoundy.com/api/auth/google/callback
#
# Facebook — developers.facebook.com → Mon application → Paramètres → Infos de base
# FACEBOOK_APP_ID=123456789012345
# FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FACEBOOK_CALLBACK_URL=https://getsoundy.com/api/auth/facebook/callback
#
# Spotify — developers.spotify.com → Dashboard → Create app → Settings
# Redirect URI (exact) : https://getsoundy.com/api/auth/spotify/callback
# SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SPOTIFY_CALLBACK_URL=https://getsoundy.com/api/auth/spotify/callback

# ── Liaison compte YouTube (optionnel) ──────────────────────────────────────
# Permet aux utilisateurs de connecter leur compte YouTube depuis leur profil
# (bouton "Connecter YouTube" → OAuth Google avec scope youtube.readonly).
# Requiert GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET ci-dessus.
# YouTube Data API v3 doit être activée dans la console Google Cloud.
#
# YOUTUBE_CALLBACK_URL=https://getsoundy.com/api/auth/youtube/callback
#
# ── Liaison compte Instagram (optionnel) ────────────────────────────────────
# Connexion Instagram profil via Facebook Login (Instagram Graph API).
# Nécessite un compte Instagram Business/Creator lié à une page Facebook.
# developers.facebook.com → app Meta → Facebook Login + Instagram Graph API
# Permissions : instagram_basic, pages_show_list
# Redirect URI : https://getsoundy.com/api/auth/instagram/callback
# FACEBOOK_APP_ID=123456789012345
# FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INSTAGRAM_CALLBACK_URL=https://getsoundy.com/api/auth/instagram/callback

# ── Cloudflare Stream (live vidéo CDN — optionnel) ───────────────────────────
# Remplace le mesh WebRTC par RTMP ingest → HLS/CDN pour les spectateurs.
# Sans ces variables, les lives utilisent WebRTC mesh (comportement actuel).
#
# 1. Compte Cloudflare → Stream activé
# 2. API Token : Account → Cloudflare Stream → Edit
# 3. Account ID : dashboard Cloudflare (barre latérale droite)
# 4. Customer subdomain : visible dans l’URL d’un live input existant
#    (ex. customer-m033z5x00ks6nunl.cloudflarestream.com → m033z5x00ks6nunl)
#
# CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDFLARE_STREAM_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=m033z5x00ks6nunl
# Alternative : CLOUDFLARE_API_TOKEN avec permissions Stream Edit

# ── LiveKit Cloud (live vidéo navigateur — optionnel, prioritaire) ───────────
# Remplace le mesh WebRTC par diffusion caméra navigateur (style Instagram).
# Si LiveKit ET Cloudflare sont configurés, LiveKit est choisi par défaut.
# Plan Build : 100 participants simultanés max, 5000 min/mois (gratuit).
#
# 1. https://cloud.livekit.io → Create project (région EU recommandée)
# 2. Project → Settings → Keys → Create key (copier une seule fois)
# 3. LIVEKIT_URL = WebSocket URL du projet (wss://xxx.livekit.cloud)
#
# LIVEKIT_URL=wss://votre-projet.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── TURN (WebRTC mesh — optionnel si pas LiveKit/Cloudflare) ─────────────────
# Credentials servis via GET /api/lives/ice-servers (jamais dans le frontend).
# TURN_URL=turn:51.159.164.100:3478?transport=udp,turn:51.159.164.100:3478?transport=tcp
# TURN_USERNAME=soundy
# TURN_CREDENTIAL=changez_moi
