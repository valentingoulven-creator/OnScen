{
  "name": "melosong-backend",
  "version": "1.0.0",
  "description": "MeloSong Real-time Geolocation & Music Sharing Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:msdev": "ts-node-dev --respawn --transpile-only src/index.ts --msdev",
    "dev:msdev:https": "ts-node-dev --respawn --transpile-only src/index.ts --msdev --https",
    "build:exe": "npm run build && node ../msdev/scripts/build-exe.js"
  },
  "bin": {
    "msdev": "dist/entry-msdev.js"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "../msdev/release"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}