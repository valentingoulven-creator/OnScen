APP_ENV=msdev

APP_NAME=msdev

PORT=4080

HOST=0.0.0.0

JWT_SECRET=msdev_jwt_secret_change_in_production

CORS_ORIGIN=*



# Smartphone / LAN — phase ultérieure (npm run msdev:sync-lan puis msdev/MOBILE-PWA.txt)

# MOBILE_HOST_IP=192.168.1.93

# MOBILE_WEB_URL=http://192.168.1.93:4080

# MOBILE_API_URL=http://192.168.1.93:4080/api

# MOBILE_SOCKET_URL=http://192.168.1.93:4080



# Caméra sur téléphone (plus tard) : npm run msdev:https puis https://192.168.x.x:4080

# MOBILE_WEB_URL=https://192.168.1.93:4080

# MOBILE_API_URL=https://192.168.1.93:4080/api

# MOBILE_SOCKET_URL=https://192.168.1.93:4080



# PC local — HTTP par défaut (LANCER-MELOSONG.bat, npm run msdev:pc)

WEB_APP_URL=http://localhost:4080

API_BASE_URL=http://localhost:4080/api

SOCKET_URL=http://localhost:4080

MSDEV_HTTPS=0



# HTTPS optionnel (npm run msdev:https) :

# WEB_APP_URL=https://localhost:4080

# API_BASE_URL=https://localhost:4080/api

# SOCKET_URL=https://localhost:4080

# MSDEV_HTTPS=1



API_BASE_URL_ANDROID=http://10.0.2.2:4080/api

SOCKET_URL_ANDROID=http://10.0.2.2:4080



# YouTube — recherche vidéos + chargement playlists publiques (recommandé)

# YOUTUBE_API_KEY=



# Bots carte monde (msdev) — 1000 par défaut ; 0 = 8 bots nommés autour du centre legacy
MSDEV_BOT_COUNT=1000
# Plafond API /geo/nearby quand « Filtrer par distance » est désactivé (salons + personnes)
GEO_NEARBY_WORLD_CAP=1100
# Lives YouTube actifs parmi les bots (cap 80) — pourcent ou nombre fixe
MSDEV_BOT_LIVE_PERCENT=10
# MSDEV_BOT_LIVE_COUNT=80


MSDEV_DUAL_IP_ENABLED=true

MSDEV_DUAL_IP_USER_A=192.168.1.93

MSDEV_DUAL_IP_USER_B=192.168.1.41

MSDEV_DUAL_IP_EMAIL_A=dj@msdev.local

MSDEV_DUAL_IP_EMAIL_B=listener@msdev.local

# --- Securite tunnel public (ngrok / ACCES-IPHONE.bat) ---
# MSDEV_PUBLIC_TUNNEL=1 est defini automatiquement par ACCES-IPHONE.bat
# Forcer le controle d'acces en local : ACCESS_CONTROL_ENABLED=1
# Emails administrateurs (gestion acces) :
# ACCESS_ADMIN_EMAILS=listener@msdev.local,dj@msdev.local

# Bots carte msdev — répartis dans le monde (défaut 1000). 0 = 8 bots centre legacy uniquement.
MSDEV_BOT_COUNT=1000



# YouTube — compte Google de l'hôte + playlists personnelles (OAuth)

# GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET=

# GOOGLE_REDIRECT_URI=http://localhost:4080/api/platforms/youtube/oauth/callback

