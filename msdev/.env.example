APP_ENV=msdev

APP_NAME=msdev

PORT=4080

HOST=0.0.0.0

JWT_SECRET=msdev_jwt_secret_change_in_production

CORS_ORIGIN=*



# Smartphone / LAN — phase ultérieure (npm run msdev:sync-lan puis msdev/MOBILE-PWA.txt)

# MOBILE_HOST_IP=192.168.1.93

# MOBILE_WEB_URL=http://192.168.1.93:4080

# MOBILE_API_URL=http://192.168.1.93:4080/api

# MOBILE_SOCKET_URL=http://192.168.1.93:4080



# Caméra sur téléphone (plus tard) : npm run msdev:https puis https://192.168.x.x:4080

# MOBILE_WEB_URL=https://192.168.1.93:4080

# MOBILE_API_URL=https://192.168.1.93:4080/api

# MOBILE_SOCKET_URL=https://192.168.1.93:4080



# PC local — HTTP par défaut (LANCER-MELOSONG.bat, npm run msdev:pc)

WEB_APP_URL=http://localhost:4080

API_BASE_URL=http://localhost:4080/api

SOCKET_URL=http://localhost:4080

MSDEV_HTTPS=0



# HTTPS optionnel (npm run msdev:https) :

# WEB_APP_URL=https://localhost:4080

# API_BASE_URL=https://localhost:4080/api

# SOCKET_URL=https://localhost:4080

# MSDEV_HTTPS=1



API_BASE_URL_ANDROID=http://10.0.2.2:4080/api

SOCKET_URL_ANDROID=http://10.0.2.2:4080



# YouTube — recherche vidéos + chargement playlists publiques (recommandé)

# YOUTUBE_API_KEY=



# Bots carte monde (msdev) — 1000 par défaut ; 0 = 8 bots nommés autour du centre legacy
MSDEV_BOT_COUNT=1000
# Plafond API /geo/nearby quand « Filtrer par distance » est désactivé (salons + personnes)
GEO_NEARBY_WORLD_CAP=1100
# Lives YouTube actifs parmi les bots (cap 80) — pourcent ou nombre fixe
MSDEV_BOT_LIVE_PERCENT=10
# MSDEV_BOT_LIVE_COUNT=80


MSDEV_DUAL_IP_ENABLED=true

MSDEV_DUAL_IP_USER_A=192.168.1.93

MSDEV_DUAL_IP_USER_B=192.168.1.41

MSDEV_DUAL_IP_EMAIL_A=dj@msdev.local

MSDEV_DUAL_IP_EMAIL_B=listener@msdev.local

# --- Securite tunnel public (ngrok / ACCES-IPHONE.bat) ---
# MSDEV_PUBLIC_TUNNEL=1 est defini automatiquement par ACCES-IPHONE.bat
# Forcer le controle d'acces en local : ACCESS_CONTROL_ENABLED=1
# Emails administrateurs (gestion acces) :
# ACCESS_ADMIN_EMAILS=listener@msdev.local,dj@msdev.local
# ACCESS_ADMIN_USERNAMES=soundy_dev  # msdev local only

# Bots carte msdev — répartis dans le monde (défaut 1000). 0 = 8 bots centre legacy uniquement.
MSDEV_BOT_COUNT=1000



# ── Google OAuth — connexion compte + liaison YouTube ────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client ID → Web application
# Authorized redirect URIs à ajouter dans la console Google Cloud :
#   http://localhost:4080/api/auth/google/callback   (connexion compte Google)
#   http://localhost:4080/api/auth/youtube/callback  (liaison YouTube)
# En mode Testing : ajouter chaque testeur dans OAuth consent screen.

# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# GOOGLE_CALLBACK_URL=http://localhost:4080/api/auth/google/callback

# GOOGLE_REDIRECT_URI=http://localhost:4080/api/platforms/youtube/oauth/callback

# YOUTUBE_CALLBACK_URL=http://localhost:4080/api/auth/youtube/callback


# Spotify — compte Spotify de l'hôte (OAuth) — developers.spotify.com → Create an App
# Ajouter comme Redirect URI : http://localhost:4080/api/auth/spotify/callback

# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_CALLBACK_URL=http://localhost:4080/api/auth/spotify/callback


# --- Pourboires live (production) — simulation automatique en msdev ---
# DONATIONS_ENABLED=1
# Commission plateforme sur les pourboires (défaut 30 %)
# DONATION_PLATFORM_FEE_PERCENT=30
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Plafond journalier simulation msdev (optionnel, EUR) :
# MSDEV_DON_DAILY_CAP=50

# --- Abonnements créateurs / Soundly+ (production) — simulation automatique en msdev ---
# SUBSCRIPTIONS_ENABLED=1
# STRIPE_PRICE_ID_TIER1=price_...        # Supporter ~4,99 €/mois
# STRIPE_PRICE_ID_TIER2=price_...        # Super fan ~9,99 €/mois
# STRIPE_PRICE_ID_SOUNDLY_PLUS=price_... # Soundly+ ~4,99 €/mois
# SUBSCRIPTION_TIER1_AMOUNT_EUR=4.99
# SUBSCRIPTION_TIER2_AMOUNT_EUR=9.99
# SUBSCRIPTION_SOUNDLY_PLUS_AMOUNT_EUR=4.99
# SUBSCRIPTION_PLATFORM_COMMISSION_PERCENT=10
# Webhook abonnements (même secret ou dédié) :
#   https://VOTRE_DOMAINE/api/subscriptions/webhook
#   Événements : checkout.session.completed, invoice.paid, customer.subscription.*
# STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# Plafond simulation msdev (optionnel, nombre d'abos/jour) :
# MSDEV_SUB_DAILY_CAP=5

# --- Cloudflare Stream (live vidéo CDN — optionnel) ---
# Sans ces variables, les lives utilisent WebRTC mesh (comportement par défaut).
# Voir backend/.env.production.example pour la procédure dashboard (token API, Account ID).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# --- LiveKit Cloud (live vidéo navigateur — optionnel, prioritaire si configuré) ---
# Plan Build gratuit : ~100 participants simultanés, 5000 min/mois.
# 1. Créer un projet sur https://cloud.livekit.io
# 2. Settings → Keys : copier URL WebSocket, API Key, API Secret
# LIVEKIT_URL=wss://votre-projet.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# LIVEKIT_API_SECRET=

# --- Sightengine (modération NSFW images — optionnel) ---
# Compte : https://sightengine.com/ — modèles nudity-2.1 + offensive-2.0
# Sans clés : modération ignorée (fail-open en msdev).
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# SIGHTENGINE_ENABLED=1
# SIGHTENGINE_FAIL_OPEN=1
# SIGHTENGINE_MODERATE_REMOTE=1
# SIGHTENGINE_EXPLICIT_THRESHOLD=0.85
# SIGHTENGINE_EROTICA_THRESHOLD=0.92
# SIGHTENGINE_OFFENSIVE_THRESHOLD=0.85

# --- Production (VPS /opt/soundly/.env — pas msdev) ---
# Voir backend/.env.production.example et deploy/README.md
# APP_ENV=production
# DATABASE_URL=postgresql://soundy:SECRET@host:5432/soundy
# PG_SSL=1   # Scaleway Managed DB Paris

