# Soundy — Caddyfile PREPROD (staging.getsoundy.com)
# Deploy : deploy/Caddyfile.staging -> /opt/soundly/deploy/Caddyfile.staging -> /etc/caddy/Caddyfile

(staging_handlers) {
	@api path /api/* /health /health/db /socket.io/* /privacy /terms /legal/mentions
	@static path /assets/* /sw.js /workbox-* /manifest.webmanifest /icon.svg /favicon.svg /pwa-* /clear-pwa /tel/*

	handle @api {
		reverse_proxy localhost:3000
	}

	handle @static {
		reverse_proxy localhost:3000
	}

	handle {
		basic_auth {
			staging $2a$14$k/6HXnyZpL0J/xXVUcLCMeWczDR/f8t8WwkEyruljBNAf9n26KXfG
		}
		reverse_proxy localhost:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
	}

	encode zstd gzip
}

staging.getsoundy.com {
	import staging_handlers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Acces par IP pendant configuration DNS
http://51.159.170.181 {
	import staging_handlers
	header -Strict-Transport-Security
}

https://51.159.170.181 {
	tls internal
	import staging_handlers
	header -Strict-Transport-Security
}
