APP_ENV=production
PORT=3000
HOST=0.0.0.0

# Obligatoire en production
JWT_SECRET=changez_moi_avec_openssl_rand_hex_32

# Origines autorisées (séparées par des virgules si besoin)
CORS_ORIGIN=http://51.159.164.100

# Premier admin (créé une seule fois si la base est vide)
# PROD_ADMIN_EMAIL=admin@example.com
# PROD_ADMIN_PASSWORD=mot_de_passe_fort
# PROD_ADMIN_USERNAME=Admin

# Emails promus admin au démarrage (séparés par virgule)
# ACCESS_ADMIN_EMAILS=admin@example.com

# Contrôle d’accès strict (inscriptions → validation admin)
# ACCESS_CONTROL_ENABLED=1

# URL publique de l'app (redirections OAuth)
WEB_APP_URL=https://getsoundy.com

# Pourboires live (optionnel)
# DONATIONS_ENABLED=1
# DONATION_PLATFORM_FEE_PERCENT=30

# ── OAuth plateformes (optionnel) ───────────────────────────────────────────
# Google Cloud Console (console.cloud.google.com) :
#   - Activer YouTube Data API v3
#   - OAuth client Web → redirect : https://getsoundy.com/api/auth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_CALLBACK_URL=https://getsoundy.com/api/auth/youtube/callback
#
# Spotify Dashboard (developers.spotify.com) :
#   - Create app → Redirect URI : https://getsoundy.com/api/auth/spotify/callback
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_CALLBACK_URL=https://getsoundy.com/api/auth/spotify/callback
#
# Meta for Developers (developers.facebook.com) — connexion Instagram profil :
#   - Créer une app Meta → produit Facebook Login
#   - Ajouter Instagram Graph API (permissions instagram_basic, pages_show_list)
#   - Redirect URI OAuth : https://getsoundy.com/api/auth/instagram/callback
#   - Compte Instagram Business/Creator lié à une page Facebook requis
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_CALLBACK_URL=https://getsoundy.com/api/auth/instagram/callback
# FACEBOOK_CALLBACK_URL=https://getsoundy.com/api/auth/facebook/callback

# ── Cloudflare Stream (live vidéo CDN — optionnel) ───────────────────────────
# Voir backend/.env.production.example pour la procédure dashboard.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# ── Sauvegardes off-site (optionnel) ─────────────────────────────────────────
# Copie secondaire locale + sync Object Storage Scaleway si configuré.
# Voir deploy/RUNBOOK-PROD.md et deploy/backup-offsite.sh
# BACKUP_OFFSITE_DIR=/opt/soundly/backups-offsite
# OFFSITE_RETENTION_DAYS=30
# SCW_BUCKET=soundy-backups
# SCW_REGION=fr-par
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# MAX_CHAT_MESSAGES_PER_ROOM=500
