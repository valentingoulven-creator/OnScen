{
  "name": "melosong",
  "version": "2.0.0",
  "private": true,
  "description": "MeloSong — salons musicaux géolocalisés (Spotify, YouTube, Lives)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valentingoulven-creator/Melo.git",
    "directory": "MeloSongv2"
  },
  "scripts": {
    "msdev": "node msdev/scripts/sync-mobile-ip.mjs && npm run app:build && npm run dev:msdev --prefix backend",
    "msdev:sync-ip": "node msdev/scripts/sync-mobile-ip.mjs",
    "msdev:app": "npm run dev --prefix app",
    "msdev:server": "npm run dev:msdev --prefix backend",
    "msdev:open": "node msdev/scripts/open.js",
    "msdev:open-safari": "MELOSONG_BROWSER=safari node msdev/scripts/open.js",
    "msdev:verify-mobile": "node msdev/scripts/verify-mobile-connectivity.mjs",
    "msdev:open-foreground": "powershell -ExecutionPolicy Bypass -File msdev/scripts/open-msdev-foreground.ps1",
    "msdev:foreground": "npm run app:build && powershell -ExecutionPolicy Bypass -File msdev/scripts/open-msdev-foreground.ps1",
    "msdev:https": "npm run app:build && npm run dev:msdev:https --prefix backend",
    "msdev:mobile-url": "node msdev/scripts/sync-mobile-ip.mjs",
    "msdev:diagnose": "powershell -ExecutionPolicy Bypass -File msdev/scripts/diagnose-mobile.ps1",
    "msdev:fix-network": "powershell -Command \"Start-Process powershell -Verb RunAs -ArgumentList '-ExecutionPolicy Bypass -File \"\"$PWD/msdev/scripts/fix-network-access.ps1\"\"'\"",
    "app:build": "npm run build --prefix app",
    "app:dev": "npm run dev --prefix app",
    "app:demo": "npm run demo --prefix app",
    "app:demo:public": "node msdev/scripts/start-public-demo.mjs",
    "build:exe": "npm run app:build && npm run build:exe --prefix backend",
    "backend:build": "npm run build --prefix backend"
  }
}