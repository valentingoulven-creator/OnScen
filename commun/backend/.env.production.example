APP_ENV=production
PORT=3000
HOST=0.0.0.0

# Obligatoire en production
JWT_SECRET=changez_moi_long_random_secret
# Ne jamais définir SKIP_EMAIL_VERIFICATION=true en production (refus au démarrage).

# Chiffrement des tokens OAuth plateforme (YouTube/Instagram) au repos.
# 32+ caractères aléatoires ; repli sur JWT_SECRET si absent (non recommandé en prod).
ENCRYPTION_KEY=changez_moi_cle_chiffrement_32_caracteres_min

# URL publique de l'app (redirections OAuth YouTube/Google/Facebook/Apple)
WEB_APP_URL=https://getsoundy.com

# Origine(s) front autorisée(s) — séparées par des virgules si plusieurs
CORS_ORIGIN=https://getsoundy.com

# --- PostgreSQL (recommandé) ---
# Active automatiquement la persistance SQL quand APP_ENV=production
DATABASE_URL=postgresql://soundy:MOT_DE_PASSE@127.0.0.1:5432/onscen-prod

# Scaleway Managed Database (Paris) — exemple :
# DATABASE_URL=postgresql://soundy:SECRET@xxx.pg.sdb.scaleway.com:5432/onscen-prod?sslmode=require
# PG_SSL=1
# PG_POOL_MAX=10

# Premier compte admin si la base est vide
PROD_ADMIN_EMAIL=admin@getsoundy.com
PROD_ADMIN_PASSWORD=changez_moi
PROD_ADMIN_USERNAME=admin

# Contrôle d'accès
# En production (APP_ENV=production), activé automatiquement — inscriptions fermées par défaut.
# Connexion : comptes existants uniquement (email/mot de passe, OAuth, WebAuthn).
# ACCESS_CONTROL_ENABLED=1 n'est plus obligatoire en prod.
#
# Rouvrir temporairement les inscriptions (déconseillé) :
# ALLOW_REGISTRATION=1
#
# Forcer un mode au démarrage (open | invite_only | admin_approval | closed) :
# ACCESS_REGISTRATION_MODE=closed
#
# Legacy (optionnel, redondant avec APP_ENV=production) :
# ACCESS_CONTROL_ENABLED=1
# ACCESS_ADMIN_EMAILS=admin@getsoundy.com
# ⚠ ACCESS_ADMIN_EMAILS est ignoré en production (APP_ENV=production).
#   En prod, l'accès admin est déterminé uniquement par le flag isAdmin en base de données
#   (initialisé via PROD_ADMIN_EMAIL au premier démarrage, puis gérable via l'UI admin).
#   Cette variable n'est active qu'en mode msdev.

# Stripe / abonnements (optionnel)
# DONATIONS_ENABLED=1
# En APP_ENV=production, les pourboires ne s'activent que si STRIPE_SECRET_KEY=sk_live_… (pas sk_test_).
# Commission plateforme sur les pourboires live (défaut 50 %, hors abonnements)
# DONATION_PLATFORM_FEE_PERCENT=50
# SUBSCRIPTIONS_ENABLED=1
# STRIPE_SECRET_KEY=sk_live_...

# ── Connexion sociale OAuth (optionnel) ──────────────────────────────────────
# Les boutons Google/Facebook apparaissent en mode "Bientôt disponible" tant
# que ces variables ne sont pas définies. Aucun redéploiement du frontend
# n'est nécessaire : le backend expose /api/auth/providers pour la détection.
#
# Google (connexion compte + YouTube) — console.cloud.google.com
# 1. Créer un projet → APIs & Services → activer « YouTube Data API v3 »
# 2. OAuth consent screen → External → scopes : youtube.readonly, email, profile
#    En mode Testing : ajouter chaque compte Google testeur (ex. admin@getsoundy.com)
#    → docs/GOOGLE-OAUTH-TEST-USERS.md
# 3. Credentials → OAuth 2.0 Client ID → Web application
# 4. Authorized redirect URIs :
#    - https://getsoundy.com/api/auth/youtube/callback  (liaison YouTube)
#    - https://getsoundy.com/api/auth/google/callback   (connexion compte, optionnel)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLE_CALLBACK_URL=https://getsoundy.com/api/auth/google/callback
#
# Facebook — developers.facebook.com → Mon application → Paramètres → Infos de base
# FACEBOOK_APP_ID=123456789012345
# FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FACEBOOK_CALLBACK_URL=https://getsoundy.com/api/auth/facebook/callback
#
# Sign in with Apple — developer.apple.com → Certificates, Identifiers & Profiles
# 1. App ID com.soundy.app → capability Sign in with Apple
# 2. Services ID (ex. com.soundy.app.web) → Web Auth → domain getsoundy.com
#    Return URL : https://getsoundy.com/api/auth/apple/callback
# 3. Keys → Sign in with Apple → télécharger AuthKey_XXXX.p8
# APPLE_CLIENT_ID=com.soundy.app.web
# APPLE_TEAM_ID=AB12CD3EFG
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_CALLBACK_URL=https://getsoundy.com/api/auth/apple/callback
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# (ou APPLE_PRIVATE_KEY_PATH=/chemin/vers/AuthKey_XXXX.p8)
#
# YouTube / Google OAuth — voir GOOGLE_* et YOUTUBE_API_KEY

# ── Liaison compte YouTube (optionnel) ──────────────────────────────────────
# Permet aux utilisateurs de connecter leur compte YouTube depuis leur profil
# (bouton "Connecter YouTube" → OAuth Google avec scope youtube.readonly).
# Requiert GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET ci-dessus.
# YouTube Data API v3 doit être activée dans la console Google Cloud.
#
# YOUTUBE_CALLBACK_URL=https://getsoundy.com/api/auth/youtube/callback
#
# Pseudos autorisés à la connexion YouTube simulée en prod (tests sans OAuth Google).
# MOCK_PLATFORM_CONNECT_USERNAMES=dye
#
# ── Liaison compte Instagram (optionnel) ────────────────────────────────────
# Connexion Instagram profil via Facebook Login (Instagram Graph API).
# Nécessite un compte Instagram Business/Creator lié à une page Facebook.
# developers.facebook.com → app Meta → Facebook Login + Instagram Graph API
# Permissions : instagram_basic, pages_show_list
# Redirect URI : https://getsoundy.com/api/auth/instagram/callback
# FACEBOOK_APP_ID=123456789012345
# FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INSTAGRAM_CALLBACK_URL=https://getsoundy.com/api/auth/instagram/callback

# ── Cloudflare Stream (live vidéo CDN — optionnel) ───────────────────────────
# Remplace le mesh WebRTC par RTMP ingest → HLS/CDN pour les spectateurs.
# Sans ces variables, les lives utilisent WebRTC mesh (comportement actuel).
#
# 1. Compte Cloudflare → Stream activé
# 2. API Token : Account → Cloudflare Stream → Edit
# 3. Account ID : dashboard Cloudflare (barre latérale droite)
# 4. Customer subdomain : visible dans l’URL d’un live input existant
#    (ex. customer-m033z5x00ks6nunl.cloudflarestream.com → m033z5x00ks6nunl)
#
# CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDFLARE_STREAM_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=m033z5x00ks6nunl
# Alternative : CLOUDFLARE_API_TOKEN avec permissions Stream Edit

# ── YouTube Data API v3 (recherche / playlists salon — optionnel) ─────────────
# Clé serveur pour recherche YouTube officielle et import de playlists publiques.
# Sans cette clé, les hôtes peuvent coller des liens YouTube manuellement ;
# la recherche distante et l'import playlist renvoient une erreur explicite.
# Console Google Cloud → activer « YouTube Data API v3 » → Credentials → API key
# (restreindre la clé à YouTube Data API v3 + IP serveur en production).
# YOUTUBE_API_KEY=AIzaSy...

# ── Alertes email admin (optionnel) ─────────────────────────────────────────
# Envoie un email à SMTP_ADMIN_EMAIL à chaque nouveau message support utilisateur,
# et des alertes de monitoring (disk/RAM/CPU/latence/crash) à admin@getsoundy.com.
#
# Production Scaleway VPS : ports SMTP 587/465 bloqués → utiliser Resend HTTP API (443).
# 1. Créer un compte sur https://resend.com (100 emails/jour gratuits)
# 2. Copier la clé API (re_...) dans RESEND_API_KEY
# 3. Pour les tests sans domaine vérifié : RESEND_FROM=OnScen <onboarding@resend.dev>
# 4. En prod avec domaine getsoundy.com vérifié : RESEND_FROM=OnScen <noreply@getsoundy.com>
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM=OnScen <onboarding@resend.dev>
# SMTP_ADMIN_EMAIL=admin@getsoundy.com
#
# Développement local (SMTP classique, optionnel) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=admin@getsoundy.com
# SMTP_PASS=xxxx xxxx xxxx xxxx        ← mot de passe d'application Gmail (16 chars)
# SMTP_FROM=OnScen <admin@getsoundy.com>
# SMTP_ADMIN_EMAIL=admin@getsoundy.com

# ── Monitoring serveur (seuils d'alerte — tous optionnels) ───────────────────
# Destinataire principal des alertes système (RAM/CPU) :
# ALERT_EMAIL=admin@getsoundy.com
#
# Destinataires supplémentaires pour les alertes monitoring (en plus de SMTP_ADMIN_EMAIL) :
# ALERT_EXTRA_EMAILS=dev1@example.com,dev2@example.com
#
# Seuils systemMonitor (RAM/CPU simples via os module) :
# RAM_ALERT_THRESHOLD=85      # % RAM (défaut 85) — alerte si dépassé, debounce 1 h
# CPU_ALERT_THRESHOLD=90      # % CPU load 1 min / cœurs (défaut 90)
#
# Seuils serverMonitor (RAM/CPU/disk/latence complets) :
# ALERT_DISK_PERCENT=80       # % disque (warning) ; 95 → critical
# ALERT_RAM_PERCENT=80        # % RAM (warning) ; 95 → critical (alias : RAM_ALERT_THRESHOLD)
# ALERT_CPU_PERCENT=80        # % CPU load (warning) ; 95 → critical (alias : CPU_ALERT_THRESHOLD)
# ALERT_LATENCY_MS=100        # ms p95 (100ms = recommandé DB-backed ; 10ms = interne pur)
# ALERT_COOLDOWN_MS=1800000   # délai minimum entre 2 emails du même type (30 min)
# MONITOR_INTERVAL_MS=300000  # intervalle de vérification (5 min)

# ── Web Push (notifications navigateur — optionnel) ─────────────────────────
# Générer une paire VAPID : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=BN...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:contact@getsoundy.com

# ── Push natif iOS/Android via Firebase Cloud Messaging (optionnel) ─────────
# Sans cette clé, les apps mobiles (Capacitor) n'envoient/reçoivent AUCUNE notification
# push en arrière-plan ou app fermée (le Web Push ci-dessus ne fonctionne pas dans une
# WebView Capacitor packagée). Étapes pour l'activer :
#   1. Créer un projet Firebase (console.firebase.google.com) — gratuit.
#   2. Android : ajouter l'app com.soundy.app, télécharger google-services.json,
#      le placer dans ios/apptel/android/app/google-services.json (jamais committé).
#   3. iOS : lier un certificat/clé APNs (Apple Developer) au projet Firebase
#      (Project Settings → Cloud Messaging → Apple app configuration).
#   4. Générer une clé de compte de service : Project Settings → Comptes de service →
#      Générer une nouvelle clé privée (fichier JSON) → coller son contenu ici (une ligne).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...", ...}

# ── LiveKit Cloud (live vidéo navigateur — optionnel, prioritaire) ───────────
# Remplace le mesh WebRTC par diffusion caméra navigateur (style Instagram).
# Si LiveKit ET Cloudflare sont configurés, LiveKit est choisi par défaut.
# Plan Build : 100 participants simultanés max, 5000 min/mois (gratuit).
#
# 1. https://cloud.livekit.io → Create project (région EU recommandée)
# 2. Project → Settings → Keys → Create key (copier une seule fois)
# 3. LIVEKIT_URL = WebSocket URL du projet (wss://xxx.livekit.cloud)
#
# LIVEKIT_URL=wss://votre-projet.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis (Socket.IO cluster — obligatoire si PM2_INSTANCES > 1) ────────────
# Partage rate limits, OAuth exchange, challenges WebAuthn, egress LiveKit.
# REDIS_URL=redis://127.0.0.1:6379

# ── Sécurité ops / 2FA ───────────────────────────────────────────────────────
# Token pour GET /health/db (header X-Ops-Health-Token ou Authorization: Bearer)
# OPS_HEALTH_TOKEN=changez_moi_token_ops_32_caracteres_minimum
# Clé AES-256 pour secrets TOTP en base (64 hex) : openssl rand -hex 32
# TOTP_ENCRYPTION_KEY=

# ── Mentions légales LCEN (obligatoire prod / preprod) ───────────────────────
# Adresse postale éditeur — non versionnée en Git. Prioritaire sur legal-publisher.json.
# Refus au boot si absent ou placeholder (voir scripts/setup-legal-prod.ps1).
# LEGAL_PUBLISHER_ADDRESS=12 rue Example, 75001 Paris, France

# Monitoring erreurs Sentry (obligatoire prod)
# Backend Node : projet backend (DSN fictif — remplacer par le DSN réel du projet Sentry)
SENTRY_DSN=https://examplePublicKey@o0000000000000000.ingest.de.sentry.io/0000000000000000
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Object storage S3-compatible (uploads sponsors, médias — optionnel) ─────
# Sans S3_BUCKET : fichiers écrits sous backend/public/uploads/ (comportement actuel).
# Avec S3 : logos/bandeaux sponsors et autres uploads via uploadObject().
# S3_BUCKET=soundy-uploads
# S3_REGION=fr-par
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.getsoundy.com
# S3_FORCE_PATH_STYLE=0
# S3_PUBLIC_READ=1

# ── TURN (WebRTC mesh — optionnel si pas LiveKit/Cloudflare) ─────────────────
# Credentials servis via GET /api/lives/ice-servers (jamais dans le frontend).
# TURN_URL=turn:51.159.164.100:3478?transport=udp,turn:51.159.164.100:3478?transport=tcp
# TURN_USERNAME=soundy
# TURN_CREDENTIAL=changez_moi

# ── Sightengine (modération NSFW images/vidéos UGC — recommandé en prod) ───
# Compte : https://sightengine.com/
# En production SANS clés : uploads images/vidéos UGC refusés (fail-closed).
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# SIGHTENGINE_ENABLED=1
# SIGHTENGINE_FAIL_OPEN=0
# SIGHTENGINE_MODERATE_REMOTE=1
# SIGHTENGINE_MODELS=nudity-2.1,offensive-2.0
# SIGHTENGINE_EXPLICIT_THRESHOLD=0.85
# SIGHTENGINE_EROTICA_THRESHOLD=0.92
# SIGHTENGINE_OFFENSIVE_THRESHOLD=0.85
# Détection mineur (face-age) + gore/weapon — activés par défaut (audit MOD-1/MOD-8), ajoutés
# automatiquement aux modèles ci-dessus. Ne désactiver qu'en connaissance de cause.
# SIGHTENGINE_MINOR_DETECTION_ENABLED=1
# SIGHTENGINE_MINOR_THRESHOLD=0.5
# SIGHTENGINE_VIOLENCE_MODELS_ENABLED=1
# SIGHTENGINE_VIOLENCE_THRESHOLD=0.85
# Échantillonnage de frames sur les lives Cloudflare Stream (audit MOD-3) — ms entre 2 captures.
# LIVE_MODERATION_SAMPLE_INTERVAL_MS=60000

# ── ACRCloud (empreinte audio — anti-upload musique commerciale — recommandé prod) ─
# Compte : https://www.acrcloud.com/ (trial 14 jours, catalogue ~150M morceaux)
# EU endpoint recommandé (RGPD) : identify-eu-west-1.acrcloud.com
# Sans clés : scan ignoré (warning au boot prod). Avec clés : blocage si match score ≥ seuil.
# ACRCLOUD_ENABLED=1
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=
# ACRCLOUD_HOST=https://identify-eu-west-1.acrcloud.com
# ACRCLOUD_MATCH_SCORE_THRESHOLD=80
# ACRCLOUD_FAIL_OPEN=0
# En msdev : ACRCLOUD_FAIL_OPEN=1 par défaut (erreur API = upload accepté)

# ── Agents IA admin (chat CEO IA + Dev Agent — admin panel) ─────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_AGENTS_PROVIDER=anthropic
# AI_AGENTS_MODEL=claude-sonnet-4-6
# AI_AGENTS_ENABLED=1
