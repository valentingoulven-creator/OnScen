# Copier vers commun/backend/.env.cloudflare (gitignore — ne pas committer)
#
# Option A — token dédié Turnstile (dashboard → API Tokens → Edit Cloudflare Turnstile)
# CLOUDFLARE_API_TOKEN=cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Option B — bootstrap automatique (crée un cfat éphémère puis les 2 widgets)
# CLOUDFLARE_API_EMAIL=admin@onscen.com
# CLOUDFLARE_GLOBAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
