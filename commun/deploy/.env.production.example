APP_ENV=production
PORT=3000
HOST=0.0.0.0

# Obligatoire en production
JWT_SECRET=changez_moi_avec_openssl_rand_hex_32

# Origines autorisées (séparées par des virgules si besoin)
CORS_ORIGIN=http://51.159.164.100

# Premier admin (créé une seule fois si la base est vide)
# PROD_ADMIN_EMAIL=admin@onscen.com
# PROD_ADMIN_PASSWORD=mot_de_passe_fort
# PROD_ADMIN_USERNAME=Admin

# Emails promus admin au démarrage (séparés par virgule)
# ACCESS_ADMIN_EMAILS=admin@onscen.com
# ⚠ Ignoré en production (APP_ENV=production) : seul le flag isAdmin en base fait foi.
#   Utilisable uniquement en mode msdev.

# Contrôle d’accès strict (inscriptions → validation admin)
# En production (APP_ENV=production), le contrôle d’accès est activé automatiquement
# et les inscriptions sont fermées par défaut (connexion des comptes existants uniquement).
# ACCESS_CONTROL_ENABLED=1 n’est plus obligatoire en prod.
#
# Rouvrir temporairement les inscriptions (déconseillé) :
# ALLOW_REGISTRATION=1
#
# Forcer un mode précis au démarrage (open | invite_only | admin_approval | closed) :
# ACCESS_REGISTRATION_MODE=closed

# URL publique de l'app (redirections OAuth)
WEB_APP_URL=https://onscen.com

# Pourboires live (optionnel)
# DONATIONS_ENABLED=1
# DONATION_PLATFORM_FEE_PERCENT=30

# ── OAuth plateformes (optionnel) ───────────────────────────────────────────
# Google Cloud Console (console.cloud.google.com) :
#   - Activer YouTube Data API v3
#   - OAuth client Web → Authorized redirect URIs :
#       https://onscen.com/api/auth/google/callback   (connexion compte Google)
#       https://onscen.com/api/auth/youtube/callback  (liaison YouTube)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLE_CALLBACK_URL=https://onscen.com/api/auth/google/callback
# YOUTUBE_CALLBACK_URL=https://onscen.com/api/auth/youtube/callback
# YouTube / Google OAuth — voir GOOGLE_* et YOUTUBE_API_KEY
#
# Meta for Developers (developers.facebook.com) — connexion Instagram profil :
#   - Créer une app Meta → produit Facebook Login
#   - Ajouter Instagram Graph API (permissions instagram_basic, pages_show_list)
#   - Redirect URI OAuth : https://onscen.com/api/auth/instagram/callback
#   - Compte Instagram Business/Creator lié à une page Facebook requis
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_CALLBACK_URL=https://onscen.com/api/auth/instagram/callback
# FACEBOOK_CALLBACK_URL=https://onscen.com/api/auth/facebook/callback

# ── Cloudflare Stream (live vidéo CDN — optionnel) ───────────────────────────
# Voir backend/.env.production.example pour la procédure dashboard.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# ── LiveKit Cloud (live vidéo navigateur — optionnel, prioritaire sur Cloudflare)
# 1. https://cloud.livekit.io → Create project (région EU recommandée)
# 2. Project → Settings → Keys → Create key
# 3. LIVEKIT_URL = WebSocket URL (wss://xxx.livekit.cloud)
# Plan Build : 100 participants simultanés, 5 000 min/mois (gratuit)
# LIVEKIT_URL=wss://votre-projet.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sauvegardes off-site (optionnel) ─────────────────────────────────────────
# Copie secondaire locale + sync Object Storage Scaleway si configuré.
# Voir deploy/RUNBOOK-PROD.md et deploy/backup-offsite.sh
# BACKUP_OFFSITE_DIR=/opt/onscen/backups-offsite
# OFFSITE_RETENTION_DAYS=14
# SCW_BUCKET=onscen-backups
# SCW_REGION=fr-par
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# MAX_CHAT_MESSAGES_PER_ROOM=500
