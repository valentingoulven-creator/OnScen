# OnScen — Caddyfile PREPROD (staging.onscen.com)
# Deploy : deploy/Caddyfile.staging -> /opt/onscen/deploy/Caddyfile.staging -> /etc/caddy/Caddyfile
#
# Preprod ouverte (UI + API) — pas d'indexation (X-Robots-Tag). Health/assets/API inchangés.

# Same Cloudflare trusted proxies as prod (staging.onscen.com once DNS exists).
{
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For True-Client-IP
	}
}

(staging_handlers) {
	handle {
		reverse_proxy localhost:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), payment=()"
		-Server
	}

	request_body {
		max_size 25MB
	}

	encode zstd gzip
}

staging.onscen.com {
	import staging_handlers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Ancien domaine legacy staging décommissionné (2026-08-11) — pas de bloc = hard stop TLS.

# Acces par IP pendant configuration DNS
http://51.159.170.181 {
	import staging_handlers
	header -Strict-Transport-Security
}

https://51.159.170.181 {
	tls internal
	import staging_handlers
	header -Strict-Transport-Security
}
