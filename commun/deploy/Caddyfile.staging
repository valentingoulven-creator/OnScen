# OnScen — Caddyfile PREPROD (staging.getsoundy.com)
# Deploy : deploy/Caddyfile.staging -> /opt/onscen/deploy/Caddyfile.staging -> /etc/caddy/Caddyfile
#
# Preprod ouverte (UI + API) — pas d'indexation (X-Robots-Tag). Health/assets/API inchangés.

(staging_handlers) {
	handle {
		reverse_proxy localhost:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
	}

	encode zstd gzip
}

staging.getsoundy.com {
	import staging_handlers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Acces par IP pendant configuration DNS
http://51.159.170.181 {
	import staging_handlers
	header -Strict-Transport-Security
}

https://51.159.170.181 {
	tls internal
	import staging_handlers
	header -Strict-Transport-Security
}
