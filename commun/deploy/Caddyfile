# OnScen — Caddyfile CANONIQUE (source de vérité)
# Repo : deploy/Caddyfile  →  VPS : /opt/onscen/deploy/Caddyfile  →  /etc/caddy/Caddyfile
#
# ⚠ NE JAMAIS écrire un bloc minimal `:80 { ... }` à la main sur le VPS.
#    Utiliser : ./deploy/sync-caddy.sh  ou  deploy-scaleway.ps1
#
# Basic Auth (pré-lancement) — optionnel, fichier VPS uniquement (jamais commité).
# Copier deploy/caddy-basic-auth.caddy.example → /opt/onscen/deploy/caddy-basic-auth.caddy
# et décommenter la ligne import ci-dessous pour réactiver la protection UI.
# import /opt/onscen/deploy/caddy-basic-auth.caddy

# Cloudflare orange-cloud is in front of onscen.com. Trust CF ranges so
# {client_ip} / X-Forwarded-For are the real visitor, not the edge.
# Ranges: https://www.cloudflare.com/ips-v4 + ips-v6 (2026-08-20).
{
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For True-Client-IP
	}
}

(onscen_handlers) {
	@allowed_ips client_ip 195.36.171.84/32

	@api path /api/* /health /health/db /socket.io/* /privacy /terms /cookies /legal/mentions
	@static path /assets/* /sw.js /workbox-* /manifest.webmanifest /icon.svg /favicon.svg /pwa-* /clear-pwa

	handle @api {
		reverse_proxy localhost:3000
	}

	handle @static {
		reverse_proxy localhost:3000
	}

	handle @allowed_ips {
		reverse_proxy localhost:3000
	}

	handle {
		reverse_proxy localhost:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), payment=()"
		-Server
	}

	request_body {
		max_size 25MB
	}

	encode zstd gzip
}

# Production — domaine principal OnScen (HTTPS automatique Let's Encrypt)
onscen.com {
	import onscen_handlers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

www.onscen.com {
	redir https://onscen.com{uri} permanent
}

# Ancien domaine legacy décommissionné (2026-08-11) — aucun bloc Caddy = pas de certificat
# TLS obtenu pour ce host, la connexion échoue au handshake (hard stop volontaire, pas de
# redirect). Ne pas réintroduire de bloc pour ce domaine ici (voir commun/docs/ONSCEN-DOMAINE.md).

# Accès par IP pendant la transition (HTTP)
http://51.159.164.100 {
	import onscen_handlers
	header -Strict-Transport-Security
}

# Accès par IP en HTTPS (certificat auto-signé)
https://51.159.164.100 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	import onscen_handlers
	header -Strict-Transport-Security
}
