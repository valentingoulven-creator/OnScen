# Copier vers app/.env.preproduction (gitignore) pour builds staging / deploy preprod.
VITE_APP_ENV=preproduction
VITE_WEB_APP_URL=https://staging.getsoundy.com
VITE_DESIGN_QUICK_WINS=1

# Connexion admin par défaut (injecté aussi via sync-app-sentry-env depuis backend .env)
# VITE_DEMO_LOGIN_EMAIL=admin@staging.getsoundy.com
# VITE_DEMO_LOGIN_PASSWORD=
# VITE_DEMO_AUTO_LOGIN=1

# Sentry staging (même org, projet dédié ou soundy-web avec environment=preproduction)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
