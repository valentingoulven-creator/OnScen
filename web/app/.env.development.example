# Copier vers web/app/.env.development pour le dev local.
# Vite charge ce fichier en mode development (npm run dev).

VITE_APP_ENV=msdev

# 1 = même UI carte que prod (filtres horizontaux, FAB, marqueurs, sidebar).
# Sans cette variable, le layout carte desktop diffère de onscen.com.
VITE_DESIGN_QUICK_WINS=1
