# Copier vers app/.env.production (gitignore) pour les builds prod / deploy.
# Vite charge ce fichier en mode production (npm run app:build / app:build:prod).

VITE_APP_ENV=production
VITE_WEB_APP_URL=https://getsoundy.com

# Monitoring erreurs (Sentry) — org bewware
# Projets réels : javascript-react (front) · backend (API)
# https://sentry.io/settings/bewware/projects/
#
# Runtime (inclus dans le bundle au build) :
# Projet javascript-react — généré via scripts/sync-app-sentry-env.ps1 depuis SENTRY_DSN backend
VITE_SENTRY_DSN=https://f4ae28ba9f6b498fc97027e5969e80cd@o4511654862258176.ingest.de.sentry.io/4511654894436432
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
#
# Upload source maps — app/.env.sentry-build-plugin
# SENTRY_ORG=bewware
# SENTRY_PROJECT=javascript-react

# Design quick wins : tokens, Plus Jakarta Sans, barre verre, Sound Rail (carte).
# 1 = actif en prod getsoundy.com | 0 ou absent = desactive
VITE_DESIGN_QUICK_WINS=1

# Donations (PayPal.me — l'app ajoute /{montant}EUR au clic)
# VITE_DONATION_PAYPAL_URL=https://paypal.me/getsoundy
